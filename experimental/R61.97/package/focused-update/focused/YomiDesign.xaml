    <DataTemplate x:Key="QueueTableRowTemplate">
        <Border Background="{Binding RowBackground}" BorderBrush="{Binding DropBorderBrush}" BorderThickness="{Binding DropBorderThickness}"
                Padding="0" CornerRadius="0" ToolTip="{Binding Explanation}" SnapsToDevicePixels="True">
            <Grid x:Name="QueueTableCells" Height="28" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1" SharedSizeGroup="QueueTableChannel"/>
                    <ColumnDefinition Width="1" SharedSizeGroup="QueueTableTime"/>
                    <ColumnDefinition Width="1" SharedSizeGroup="QueueTableState"/>
                    <ColumnDefinition Width="1" SharedSizeGroup="QueueTableMedia"/>
                    <ColumnDefinition Width="1" SharedSizeGroup="QueueTablePlays"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="8" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Hairline}" Opacity="0.42" IsHitTestVisible="False"/>
                <Button Grid.Column="0" Tag="queue-row-favorite" Content="{Binding FavoriteGlyph}" Style="{StaticResource InlineHitButton}"
                        Width="22" Height="22" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                        Foreground="{DynamicResource TextMuted}" Opacity="0.52" ToolTip="Favorite" AutomationProperties.Name="Toggle queue favorite"/>
                <TextBlock Grid.Column="1" Text="{Binding Slot}" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" Foreground="{Binding PositionBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="2,0,6,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding PositionLabel}"/>
                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14.5" Foreground="{Binding TitleBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="7,0,7,0" ToolTip="{Binding Title}"/>
                <TextBlock Grid.Column="3" Text="{Binding Channel}" FontSize="13.5" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="7,0,7,0" ToolTip="{Binding Channel}"/>
                <TextBlock Grid.Column="4" Text="{Binding DurationLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="13.5"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,7,0"/>
                <TextBlock Grid.Column="5" Text="{Binding DisplayStatus}" FontFamily="Cascadia Mono, Consolas" FontSize="13.5"
                           FontWeight="SemiBold" Foreground="{Binding StatusForeground}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="7,0,5,0"/>
                <TextBlock Grid.Column="6" Text="{Binding MediaSummary}" FontSize="13.5" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="7,0,7,0" ToolTip="{Binding ReadinessSummary}"/>
                <TextBlock Grid.Column="7" Text="{Binding PlayCountLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="13.5"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,7,0"/>
                
            </Grid>
        </Border>
    </DataTemplate>

