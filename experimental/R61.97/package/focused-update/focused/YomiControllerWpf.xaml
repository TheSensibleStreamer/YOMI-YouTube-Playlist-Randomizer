                                        </Grid>
                                    </Border>
                                </Grid>


                                <Border x:Name="MediaStateOverlay" Background="#D9090B0D" Visibility="Collapsed" IsHitTestVisible="True">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="240">
                                        <TextBlock x:Name="MediaStateTitleText" Text="" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="MediaStateBodyText" Text="" FontSize="14" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
