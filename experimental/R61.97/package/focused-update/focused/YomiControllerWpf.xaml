                                    <TextBlock x:Name="WorkerText" Text="Workers" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"/>
                                </Border>
                            </WrapPanel>

                            <TextBlock Grid.Row="8" x:Name="TechnicalText" Text="" Visibility="Collapsed" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis"/>
                            <Grid Grid.Row="8" x:Name="TrackContextRail" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="PreviousUpStrip" Style="{StaticResource TrackContextCard}" ToolTip="Play previous occurrence" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="142"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Previous" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        <TextBlock Grid.Column="1" x:Name="PreviousUpTitleText" Text="No previous track" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
