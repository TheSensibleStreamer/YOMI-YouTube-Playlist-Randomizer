                                    </StackPanel>
                                </Border>

                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" Height="24" Padding="8,0" CornerRadius="12" Background="#B50B0E11" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" Visibility="Collapsed">
