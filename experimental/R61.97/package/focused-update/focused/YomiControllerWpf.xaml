                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="PoolDeduplicateCheck" Content="Collapse the same video across sources" IsChecked="True" Style="{StaticResource SettingsCheck}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Mix" Style="{StaticResource SettingsLabel}"/>
                                        <ComboBox x:Name="PoolShuffleModeCombo" Style="{StaticResource SettingsCombo}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="PoolCurrentSummaryText" Text="No Pool built yet" Style="{StaticResource Text.Mono}" Margin="0,12,0,0"/>
                                <Border Margin="0,12,0,0" Padding="11,9" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Text="Global random shuffles all resolved tracks together. Balanced sources alternates between playlists so very large playlists do not dominate; 2x or 3x increases a source’s share." Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="3" Background="{DynamicResource Border}"/>
                        <Grid Grid.Row="4" Margin="2,12,2,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PoolStatusText" Text="Ready." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <Button Grid.Column="1" x:Name="PoolBuildButton" Content="Build + shuffle" Style="{StaticResource SettingsActionButton}" Padding="16,0" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderStrong}" Foreground="{DynamicResource TextPrimary}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- R61.36: direct playlist editing stays inside YOMI instead of launching a .txt file in Notepad. -->
        <Border Grid.Row="2" x:Name="PlaylistEditorOverlay" Panel.ZIndex="1024" Background="{DynamicResource Surface}" Visibility="Collapsed">
            <Grid>
                <Border x:Name="PlaylistEditorCard" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="0" CornerRadius="0" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Width="0" Height="0" Visibility="Collapsed"/>
                        <Grid Margin="2,0,2,13">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Playlist" Style="{StaticResource Text.Eyebrow}"/>
                                <TextBlock Text="Edit the source list" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,0"/>
                                <TextBlock Text="Enter one YouTube video URL per line." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,18,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="PlaylistEditorCloseButton" Content="Cancel" Style="{StaticResource OverlayActionButton}" VerticalAlignment="Top"/>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource Border}"/>
                        <TextBox Grid.Row="2" x:Name="PlaylistEditorBox" Margin="0,14,0,14" Padding="10,8" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceRaised}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource Border}" BorderThickness="1" FontFamily="Cascadia Mono, Consolas" FontSize="14" SpellCheck.IsEnabled="False" AutomationProperties.Name="Playlist source URLs"/>
                        <Border Grid.Row="3" Background="{DynamicResource Border}"/>
                        <Grid Grid.Row="4" Margin="2,12,2,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PlaylistEditorStatusText" Text="No changes." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <Button Grid.Column="1" x:Name="PlaylistEditorSaveButton" Content="Save playlist" Style="{StaticResource SettingsActionButton}" Padding="16,0" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderStrong}" Foreground="{DynamicResource TextPrimary}" IsEnabled="False"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.RowSpan="4" x:Name="ToastHost" Panel.ZIndex="900" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="300" Margin="0,0,18,18" Padding="12,10" CornerRadius="3" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="0" Visibility="Collapsed"/>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="ToastTitle" Text="YOMI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="ToastBody" Text="" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Operator Deck: contextual workflow macros, not permanent chrome. -->
        <Border Grid.RowSpan="4" x:Name="OperatorDeckOverlay" Panel.ZIndex="1005" Background="#9C000000" Visibility="Collapsed">
            <Grid>
                <Border x:Name="OperatorDeckCard" Width="760" MaxHeight="650" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,74,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="2" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Width="0" Height="0" Visibility="Collapsed"/>
                        <Grid Margin="2,0,2,13">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Playback tools" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center"/>
                                    <TextBlock Text="" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Common playback and broadcast actions." Style="{StaticResource Text.Caption}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="OperatorDeckCloseButton" Content="Close" Style="{StaticResource OverlayActionButton}" />
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource Border}"/>
                        <Grid Grid.Row="2" Margin="0,14,0,12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                            <Button x:Name="OperatorPrimeBroadcastButton" Style="{StaticResource OperatorCardButton}">
                                <StackPanel><TextBlock Text="Prepare broadcast" Style="{StaticResource Text.Eyebrow}"/><TextBlock Text="Save the queue, open Broadcast settings, and check the next 10 tracks." FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Prepare the current session for streaming." Style="{StaticResource Text.Caption}" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                            <Button Grid.Column="2" x:Name="OperatorLockWindowButton" Style="{StaticResource OperatorCardButton}">
                                <StackPanel><TextBlock Text="Lock prepared window" Style="{StaticResource Text.Eyebrow}"/><TextBlock Text="Save the queue, check the next 10 tracks, then keep the prepared broadcast window stable." FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Keep the prepared broadcast window unchanged." Style="{StaticResource Text.Caption}" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                            <Button Grid.Column="4" x:Name="OperatorQueueTriageButton" Style="{StaticResource OperatorCardButton}">
                                <StackPanel><TextBlock Text="Review queue issues" Style="{StaticResource Text.Eyebrow}"/><TextBlock Text="Open Queue issues with Inspector available." FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Review tracks that may need attention." Style="{StaticResource Text.Caption}" Margin="0,7,0,0"/></StackPanel>
                            </Button>

                            <Button Grid.Row="2" x:Name="OperatorFocusPlayerButton" Style="{StaticResource OperatorCardButton}">
                                <StackPanel><TextBlock Text="Focus player" Style="{StaticResource Text.Eyebrow}"/><TextBlock Text="Return to the normal playback-first Player view." FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Hide secondary tools and focus on playback." Style="{StaticResource Text.Caption}" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="2" x:Name="OperatorVisualShowButton" Style="{StaticResource OperatorCardButton}">
                                <StackPanel><TextBlock Text="Visual show" Style="{StaticResource Text.Eyebrow}"/><TextBlock Text="Open the visual broadcast layout with thumbnail, video, and visualizer." FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Uses the most visual built-in layout." Style="{StaticResource Text.Caption}" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="4" x:Name="OperatorSnapshotButton" Style="{StaticResource OperatorCardButton}">
                                <StackPanel><TextBlock Text="Save queue snapshot" Style="{StaticResource Text.Eyebrow}"/><TextBlock Text="Save the current queue order as a checkpoint." FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="The current playback order is unchanged." Style="{StaticResource Text.Caption}" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                        </Grid>
                        <Border Grid.Row="3" Padding="12,9" CornerRadius="3" Background="{DynamicResource BlackPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OperatorDeckStatusText" Text="Player    Buffer    Forecast    Protection    Queue" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="Ctrl+Shift+K opens tools    1–6 runs an action" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" Margin="16,0,0,0"/></Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- DEV13.37.2 Intent Fabric: execution plans + provenance black box. -->
        <Border Grid.RowSpan="4" x:Name="IntentFabricOverlay" Panel.ZIndex="1008" Background="#9C000000" Visibility="Collapsed">
            <Grid>
                <Border x:Name="IntentFabricCard" Width="930" MaxHeight="690" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,48,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="2" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Width="0" Height="0" Visibility="Collapsed"/>
                        <Grid Margin="2,0,2,13">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="Activity log" Style="{StaticResource Text.Eyebrow}"/><TextBlock Text="" Style="{StaticResource Text.Mono}" Margin="10,0,0,0"/></StackPanel>
                                <TextBlock Text="History and recovery details for advanced actions." Style="{StaticResource Text.Caption}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="IntentAbortButton" Content="Cancel action" Style="{StaticResource OverlayActionButton}"  Margin="0,0,8,0"/>
                                <Button x:Name="IntentVerifyButton" Content="Verify" Style="{StaticResource OverlayActionButton}"  Margin="0,0,8,0"/>
                                <Button x:Name="IntentCopyButton" Content="Copy log" Style="{StaticResource OverlayActionButton}"  Margin="0,0,8,0"/>
                                <Button x:Name="IntentCloseButton" Content="Close" Style="{StaticResource OverlayActionButton}" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource Border}"/>
                        <Border Grid.Row="2" Margin="0,12" Padding="12,10" CornerRadius="3" Background="{DynamicResource BlackPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <StackPanel><TextBlock x:Name="IntentActiveText" Text="No action in progress" FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/><TextBlock x:Name="IntentChainText" Text="Integrity" Style="{StaticResource Text.Mono}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                        <Border Grid.Row="3" Background="{DynamicResource Border}"/>
                        <ListBox Grid.Row="4" x:Name="IntentJournalList" Margin="0,10,0,8" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="3" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="92"/><ColumnDefinition Width="118"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SequenceText}" Style="{StaticResource Text.Mono}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource Text.Mono}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding State}" Style="{StaticResource Text.Eyebrow}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Plan}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Step}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Reason}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="8,0,8,0"/>
                                            <TextBlock Grid.Column="6" Text="{Binding HashShort}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="5" Margin="4,3,4,0"><TextBlock Text="Ctrl+Shift+L: activity log    Ctrl+Shift+X: cancel current action    ambiguous engine state is never guessed" Style="{StaticResource Text.Caption}"/><TextBlock Text="Integrity protected" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right"/></Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>


        <!-- DEV13.56: recovered civilization + persistent workspace + World Passport/Evidence Spine remain dormant until explicitly opened. -->
        <!-- R50 Discoverability Fidelity: existing actions reveal themselves without permanent button sprawl. -->
        <!-- Command palette: power features without permanent button sprawl. -->
        <Border Grid.RowSpan="4" x:Name="CommandPaletteOverlay" Panel.ZIndex="1000" Background="#92000000" Visibility="Collapsed">
            <Grid>
                <Border x:Name="CommandPaletteCard" Width="620" MaxHeight="520" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,92,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="3" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="2,2,2,10">
                            <TextBox x:Name="CommandPaletteSearch" Height="44" Style="{StaticResource SearchBox}" FontSize="14" Padding="13,10" AutomationProperties.Name="Command palette search"/>
