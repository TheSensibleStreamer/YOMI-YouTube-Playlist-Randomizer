                <Border x:Name="NowPlayingSurface" Grid.Row="0" Background="{DynamicResource PlayerAtmosphere}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="6,3,6,4">
