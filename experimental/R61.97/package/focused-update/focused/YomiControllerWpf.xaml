                                        <Border x:Name="PreviousContextQuickStrip" Grid.Column="3" Visibility="Collapsed" Width="0" Height="0" IsHitTestVisible="False" Focusable="False">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="PreviousAgainButton" Content="Play next" Style="{StaticResource ChromeButton}" Height="24" MinWidth="76" Padding="6,0" ToolTip="Make this the very next track after the current one"/>
                                                <Button x:Name="PreviousLocateButton" Content="Find" Style="{StaticResource ChromeButton}" Height="24" MinWidth="44" Padding="6,0" Margin="3,0,0,0" ToolTip="Find this track in the queue"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" x:Name="NextUpStrip" Style="{StaticResource TrackContextCard}" ToolTip="Play next occurrence" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="142"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Next" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        <TextBlock Grid.Column="1" x:Name="NextUpTitleText" Text="Waiting for queue..." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="NextUpStateText" Text="" Visibility="Collapsed" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="9,0,8,0" VerticalAlignment="Center"/>
                                        <Border x:Name="NextContextQuickStrip" Grid.Column="3" Visibility="Collapsed" Width="0" Height="0" IsHitTestVisible="False" Focusable="False">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="NextLaterButton" Content="Move later" Style="{StaticResource ChromeButton}" Height="24" MinWidth="76" Padding="6,0" ToolTip="Move this track five positions deeper in the queue"/>
                                                <Button x:Name="NextLocateButton" Content="Find" Style="{StaticResource ChromeButton}" Height="24" MinWidth="44" Padding="6,0" Margin="3,0,0,0" ToolTip="Find this track in the queue"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- R61.94: transport lives beside Now Playing/media; it no longer consumes a full-window band. -->
                            <Grid x:Name="TransportSurface" Grid.Row="6" Margin="0,5,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
            
                                <Grid x:Name="SeekSurface" Height="28" Background="Transparent" Cursor="Hand">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ElapsedText" Text="0:00" FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click to switch between remaining and total time"/>
                                    <Grid x:Name="ProgressSurface" Grid.Column="1" Height="24" Margin="8,0" VerticalAlignment="Center">
                                        <Border x:Name="ProgressTrack" Height="4" CornerRadius="0" Background="{DynamicResource ControlTrack}" BorderThickness="0" VerticalAlignment="Center"/>
                                        <Border x:Name="ProgressFill" Height="4" Width="0" CornerRadius="0" Background="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <Ellipse x:Name="ProgressThumb" Width="8" Height="8" Fill="{DynamicResource Accent}" Stroke="{DynamicResource AccentBorder}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0"/>
                                        <Canvas x:Name="SeekOverlay" IsHitTestVisible="False" ClipToBounds="False">
                                            <Border x:Name="SeekPreviewMarker" Visibility="Collapsed" Width="1" Height="12" Background="{DynamicResource TextSecondary}" Opacity="0.72" Canvas.Top="4"/>
                                            <Border x:Name="SeekPreviewBubble" Visibility="Collapsed" Width="54" Height="22" CornerRadius="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" Canvas.Top="-20">
                                                <TextBlock x:Name="SeekPreviewText" Text="0:00" FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                    <TextBlock Grid.Column="2" x:Name="RemainingText" Text="-0:00" FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Hand" ToolTip="Click to switch between remaining and total time"/>
                                </Grid>
            
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel x:Name="MediaQuickControls" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <ToggleButton x:Name="MediaThumbnailToggle" Content="Art" Style="{StaticResource ToggleAction}" Height="30" IsChecked="True" ToolTip="Show or hide thumbnail preview  Ctrl+1" AutomationProperties.Name="Toggle thumbnail preview"/>
                                            <ToggleButton x:Name="MediaVideoToggle" Content="Vid" Style="{StaticResource ToggleAction}" Height="30" Margin="5,0,0,0" IsChecked="False" ToolTip="Show or hide video preview  Ctrl+2" AutomationProperties.Name="Toggle video preview"/>
                                            <ToggleButton x:Name="VisualizerToggle" Content="Viz" Style="{StaticResource ToggleAction}" Height="30" Margin="6,0,0,0" IsChecked="True" ToolTip="Show or hide the visualizer  Ctrl+Shift+V" AutomationProperties.Name="Toggle visualizer"/>
                                            <Button x:Name="VisualizerSettingsButton" Style="{StaticResource ChromeButton}" Width="30" Height="30" Margin="4,0,0,0" Padding="0" ToolTip="Visualizer settings" AutomationProperties.Name="Open visualizer settings">
                                                <Grid Width="15" Height="15" SnapsToDevicePixels="True">
                                                    <Path Data="M1,3 H14 M1,8 H14 M1,13 H14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                                                    <Rectangle Width="3" Height="5" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource SurfaceRaised}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                                                    <Rectangle Width="3" Height="5" Margin="0,5,4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource SurfaceRaised}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                                                    <Rectangle Width="3" Height="5" Margin="6,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource SurfaceRaised}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>

                                        <!-- R61.97: tiny source raster scales only at presentation time; nearest-neighbor keeps edges sharp and CPU cost microscopic. -->
                                        <Border x:Name="VisualizerSurface" Grid.Column="1" MinWidth="96" MaxWidth="360" Height="28" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,10,0" Background="#000000" BorderThickness="0" CornerRadius="0" ClipToBounds="True">
                                            <Grid Background="#000000">
                                                <Image x:Name="VisualizerFrameHost" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                <MediaElement x:Name="VisualizerHost" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsMuted="True" ScrubbingEnabled="True" Visibility="Collapsed"/>
                                                <Border x:Name="VisualizerWaitingOverlay" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="VisualizerWaitingText" Text="" Visibility="Collapsed"/></Border>
                                                <Border x:Name="VisualizerChrome" Visibility="Collapsed"/>
                                                <Border x:Name="VisualizerQuickStrip" Visibility="Collapsed" IsHitTestVisible="False" Width="0" Height="0"><Button x:Name="VisualizerSizeButton" Content="Standard" Style="{StaticResource ChromeButton}" Height="28" MinWidth="82" Padding="9,0" ToolTip="Cycle visualizer size" AutomationProperties.Name="Cycle visualizer size"/></Border>
                                                <TextBlock x:Name="VisualizerLabelText" Text="Visualizer" Visibility="Collapsed"/>
                                                <TextBlock x:Name="VisualizerMetaText" Text="" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
            
                                    <Grid Grid.Column="1" x:Name="TransportDatumDeck" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="PreviousButton" IsEnabled="False" ToolTip="Previous track" Style="{StaticResource TransportButton}" AutomationProperties.Name="Previous track">
                                            <Grid Width="19" Height="18">
                                                <Path Data="M 4,3 L 4,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/>
                                                <Path Data="M 15,3 L 7,9 15,15 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="PlayPauseButton" ToolTip="Play or pause (Space)" Style="{StaticResource PrimaryTransportButton}" AutomationProperties.Name="Play or pause">
                                            <Grid Width="22" Height="22">
                                                <Path x:Name="PlayGlyph" Data="M 6,3 L 17,10 6,17 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <Grid x:Name="PauseGlyph" Visibility="Collapsed">
                                                    <Rectangle Width="4" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Left" Margin="4,3,0,3"/>
                                                    <Rectangle Width="4" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Right" Margin="0,3,4,3"/>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="NextButton" IsEnabled="False" ToolTip="Next track" Style="{StaticResource TransportButton}" AutomationProperties.Name="Next track">
                                            <Grid Width="19" Height="18">
                                                <Path Data="M 4,3 L 12,9 4,15 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <Path Data="M 15,3 L 15,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/>
                                            </Grid>
                                        </Button>
                                        </StackPanel>
                                    </Grid>
            
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="RepeatStatePill" Visibility="Visible" Height="30" MinWidth="92" Padding="9,0" Margin="0,0,8,0" Style="{StaticResource QuietActionButton}" ToolTip="Repeat mode. Click to cycle Off, All, and One.">
                                            <TextBlock x:Name="RepeatStateText" Text="Repeat All" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button x:Name="VolumeButton" Content="Volume" Visibility="Collapsed" IsTabStop="False" Style="{StaticResource QuietActionButton}" Height="30" MinWidth="74" Padding="9,0" ToolTip="Compact volume popup anchor" AutomationProperties.Name="Output volume"/>
                                        <Grid x:Name="MainVolumeSurface" Margin="0,0,2,0" VerticalAlignment="Center" ToolTip="Output volume. Click or drag immediately; mouse wheel adjusts while hovered.">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="98"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Vol" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <Slider Grid.Column="1" x:Name="MainVolumeSlider" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="130" Value="100" SmallChange="2" LargeChange="10" IsMoveToPointEnabled="True" AutomationProperties.Name="Output volume"/>
                                            <TextBlock Grid.Column="2" x:Name="MainVolumeValueText" Text="100%" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ToggleButton x:Name="QueueToggle" Content="Queue" Style="{StaticResource ToggleAction}" Height="30" Margin="7,0,0,0" ToolTip="Show or hide Queue (Ctrl+Q)" AutomationProperties.Name="Toggle queue"/>
                                        <Button x:Name="MoreButton" Content="⋯" ToolTip="More actions. Ctrl+K finds any action." Style="{StaticResource QuietActionButton}" Height="30" Width="32" Margin="6,0,0,0" Padding="0" Visibility="Visible" AutomationProperties.Name="More actions"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="MiniContextSurface" Grid.Row="6" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="1" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Next" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Grid.Column="1" x:Name="MiniNextText" Text="" FontSize="14" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Cursor="Hand" ToolTip="Play this next track now"/>
                        <Button Grid.Column="2" x:Name="MiniMicroButton" Content="Micro" Style="{StaticResource CompactQuietButton}" Margin="10,0,0,0" ToolTip="Collapse into the Micro appliance"/>
                        <Button Grid.Column="3" x:Name="MiniQueueButton" Content="Queue" Style="{StaticResource CompactQuietButton}" Margin="6,0,0,0" ToolTip="Open Queue"/>
                        <Button Grid.Column="4" x:Name="MiniExpandButton" Content="Full" Style="{StaticResource CompactQuietButton}" Margin="6,0,0,0" ToolTip="Return to Player"/>
                    </Grid>
                </Border>

                <Border x:Name="RuntimeSurface" Grid.Row="6" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="1" Padding="10,7">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="RuntimePill" Grid.Row="0" Grid.Column="0" Height="22" Padding="7,0" CornerRadius="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                            <TextBlock x:Name="RuntimeText" Text="Player" FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="SystemStatusText" Text="Connecting to the YOMI runtime..." FontSize="14" ToolTip="Current playback status. Ctrl+I opens Inspector for details." Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" x:Name="ModeText" Text="" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" Margin="12,0,0,0"/>

                        <Border Grid.Row="1" Grid.ColumnSpan="4" x:Name="OperatorHealthRail" Visibility="Collapsed" Margin="0,9,0,0" Padding="0,9,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <WrapPanel VerticalAlignment="Center">
                                    <Border x:Name="OperatorBufferChip" Style="{StaticResource HealthChip}" Cursor="Hand" ToolTip="Open ready queue scope">
                                        <TextBlock x:Name="OperatorBufferText" Text="Audio ready" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="OperatorOracleChip" Style="{StaticResource HealthChip}" Cursor="Hand" ToolTip="Show next-track readiness prediction">
                                        <TextBlock x:Name="OperatorOracleText" Text="Next track" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="OperatorAegisChip" Style="{StaticResource HealthChip}" Cursor="Hand" ToolTip="Show YOMI background workload protection">
                                        <TextBlock x:Name="OperatorAegisText" Text="System" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="OperatorOrderChip" Style="{StaticResource HealthChip}" Cursor="Hand" ToolTip="Open the current queue order">
                                        <TextBlock x:Name="OperatorOrderText" Text="Queue" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="OperatorBroadcastChip" Style="{StaticResource HealthChip}" Cursor="Hand" ToolTip="Open playback tools">
                                        <TextBlock x:Name="OperatorBroadcastText" Text="OBS idle" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="OperatorIntentChip" Style="{StaticResource HealthChip}" Cursor="Hand" ToolTip="Advanced action history (Ctrl+Shift+L)">
                                        <TextBlock x:Name="OperatorIntentText" Text="No pending actions" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"/>
                                    </Border>
                                </WrapPanel>
                                <Border Grid.Column="1" x:Name="OperatorDeckChip" Height="24" Padding="8,0" CornerRadius="5" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Cursor="Hand" ToolTip="Playback tools (Ctrl+Shift+K)">
                                    <TextBlock Text="Tools" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="InspectorSurface" Grid.Row="7" Visibility="Collapsed" Margin="0,7,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="2" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Width="0" Height="0" Visibility="Collapsed"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Inspector" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center"/>
                                <TextBlock Text="Track details, media readiness, and what YOMI is doing" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="InspectorCopyButton" Content="Copy details" Style="{StaticResource OverlayActionButton}" />
                                <Button x:Name="InspectorOpenSourceButton" Content="Open track page in browser" Style="{StaticResource OverlayActionButton}" Margin="7,0,0,0" ToolTip="Opens the selected track page in your default web browser"/>
                                <Button x:Name="InspectorCloseButton" Content="Close" Style="{StaticResource OverlayActionButton}"  Margin="7,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.55*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Track" Style="{StaticResource Text.Eyebrow}"/>
                                <TextBox x:Name="InspectorTrackTitle" Text="No track selected" Style="{StaticResource SelectableBodyText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBox x:Name="InspectorIdentityText" Text="Occurrence" Style="{StaticResource SelectableMonoDetailText}" Margin="0,5,0,0"/>
                                <TextBox x:Name="InspectorSourceText" Text="Channel" Style="{StaticResource SelectableCaptionDetailText}" Margin="0,4,0,0"/>
                                <TextBox x:Name="InspectorMemoryText" Text="Listening: unheard" Style="{StaticResource SelectableMonoDetailText}" Foreground="{DynamicResource Info}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Background="{DynamicResource Border}" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Readiness" Style="{StaticResource Text.Eyebrow}"/>
                                <TextBox x:Name="InspectorReadinessText" Text="State" Style="{StaticResource SelectableMonoDetailText}" Margin="0,6,0,0"/>
                                <TextBox x:Name="InspectorMediaText" Text="Media" Style="{StaticResource SelectableMonoDetailText}" Margin="0,5,0,0"/>
                                <TextBox x:Name="InspectorRouteText" Text="Readiness" Style="{StaticResource SelectableCaptionDetailText}" Margin="0,4,0,0"/>
                                <TextBox x:Name="InspectorRouteHistoryText" Text="Media path" Style="{StaticResource SelectableMonoDetailText}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="3" Width="1" Background="{DynamicResource Border}" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Background activity" Style="{StaticResource Text.Eyebrow}"/>
                                <TextBox x:Name="InspectorSystemSummaryText" Text="YOMI is waiting for runtime information." Style="{StaticResource SelectableDetailText}" Margin="0,6,0,0"/>
                                <TextBox x:Name="InspectorRuntimeText" Text="Technical details" Style="{StaticResource SelectableMonoDetailText}" Margin="0,7,0,0"/>
                                <TextBox x:Name="InspectorSessionText" Text="Session" Style="{StaticResource SelectableCaptionDetailText}" Margin="0,4,0,0"/>
                                <TextBox x:Name="InspectorActivityText" Text="No activity recorded in this YOMI session." Style="{StaticResource SelectableMonoDetailText}" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock x:Name="FooterHint" Grid.Row="8" Text="" Visibility="Collapsed" Height="0"/>
            </Grid>

            <!-- R61.58: Mini is a dedicated transport surface. It never inherits full-player menu/media geometry. -->
            <!-- R61.67: the full Queue workbench owns a purpose-built horizontal transport dock at every full-window size. Mini remains Mini. -->
            <Border Grid.Row="0" Grid.Column="0" x:Name="QueuePlayerDockSurface" Visibility="Collapsed" Background="{DynamicResource ChromeAtmosphere}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0" Padding="10,6,10,6" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                            <Run Text="{Binding Text, ElementName=TitleText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <Run Text="      " Foreground="{DynamicResource TextMuted}"/>
                            <Run Text="{Binding Text, ElementName=ChannelText}" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="QueueDockPositionButton" Content="Top" Style="{StaticResource CompactQuietButton}" Height="26" MinWidth="44" Padding="7,0" ToolTip="Move player dock to the opposite edge"/>
                            <Button x:Name="QueueDockRepeatButton" Content="Repeat All" Style="{StaticResource CompactQuietButton}" Height="28" MinWidth="86" Padding="9,0" Margin="5,0,0,0" ToolTip="Repeat mode. Click to cycle Off, All, and One."/>
                            <Button x:Name="QueueDockPlayerButton" Content="Player" Style="{StaticResource CompactQuietButton}" Height="26" MinWidth="54" Padding="7,0" Margin="5,0,0,0" ToolTip="Close Queue and return to full player"/>
                            <Button x:Name="QueueDockHideButton" Content="Close" Style="{StaticResource ChromeButton}" Width="52" Height="26" Padding="6,0" Margin="5,0,0,0" ToolTip="Close Queue (Ctrl+Q)" AutomationProperties.Name="Close queue workspace"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="QueueDockPreviousButton" Style="{StaticResource CompactQuietButton}" Width="38" Height="34" ToolTip="Previous track" AutomationProperties.Name="Queue dock previous">
                            <Grid Width="14" Height="14"><Path Data="M 2,2 L 2,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/><Path Data="M 12,2 L 5,7 12,12 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Grid>
                        </Button>
                        <Button Grid.Column="1" x:Name="QueueDockPlayPauseButton" Style="{StaticResource PrimaryTransportButton}" Width="60" Height="40" Margin="4,0,0,0" ToolTip="Play or pause" AutomationProperties.Name="Queue dock play or pause">
                            <Grid Width="22" Height="22"><Path Data="M 5,2 L 17,10 5,18 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Visibility="{Binding Visibility, ElementName=PlayGlyph}"/><Grid Visibility="{Binding Visibility, ElementName=PauseGlyph}"><Rectangle Width="3" Height="11" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Left" Margin="2,2,0,2"/><Rectangle Width="3" Height="11" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Right" Margin="0,2,2,2"/></Grid></Grid>
                        </Button>
                        <Button Grid.Column="2" x:Name="QueueDockNextButton" Style="{StaticResource CompactQuietButton}" Width="38" Height="34" Margin="4,0,0,0" ToolTip="Next track" AutomationProperties.Name="Queue dock next">
                            <Grid Width="14" Height="14"><Path Data="M 2,2 L 9,7 2,12 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Path Data="M 12,2 L 12,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/></Grid>
                        </Button>
                        <TextBlock Grid.Column="3" x:Name="QueueDockElapsedText" Text="{Binding Text, ElementName=ElapsedText}" FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center" Margin="7,0,5,0" Cursor="Hand"/>
                        <Grid Grid.Column="4" x:Name="QueueDockSeekSurface" Background="Transparent" Cursor="Hand" Height="26">
                            <Grid Height="20" Margin="4,0" VerticalAlignment="Center">
                                <Border x:Name="QueueDockProgressTrack" Height="3" CornerRadius="1.5" Background="{DynamicResource ControlTrack}" VerticalAlignment="Center"/>
                                <Border x:Name="QueueDockProgressFill" Height="3" Width="0" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Ellipse x:Name="QueueDockProgressThumb" Width="7" Height="7" Fill="{DynamicResource Accent}" Stroke="{DynamicResource AccentBorder}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-4,0,0,0"/>
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Column="5" x:Name="QueueDockRemainingText" Text="{Binding Text, ElementName=RemainingText}" FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center" Margin="5,0,4,0" Cursor="Hand"/>
                        <Button Grid.Column="6" x:Name="QueueDockVolumeButton" Content="Volume" Style="{StaticResource CompactQuietButton}" Height="28" MinWidth="76" Padding="8,0" ToolTip="Output volume. Mouse wheel adjusts." AutomationProperties.Name="Queue dock volume"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="0" x:Name="MiniSurface" Visibility="Collapsed" Background="Transparent" BorderBrush="{DynamicResource Hairline}" BorderThickness="0" Padding="8,5,8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Text, ElementName=TitleText}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Text="{Binding Text, ElementName=ChannelText}" FontSize="14" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </Grid>

                    <Grid Grid.Row="2" x:Name="MiniSeekSurface" Background="Transparent" Cursor="Hand">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Text, ElementName=ElapsedText}" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Height="22" Margin="7,0" VerticalAlignment="Center">
                            <Border x:Name="MiniProgressTrack" Height="4" CornerRadius="0" Background="{DynamicResource ControlTrack}" BorderThickness="0" VerticalAlignment="Center"/>
                            <Border x:Name="MiniProgressFill" Height="4" Width="0" CornerRadius="0" Background="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Ellipse x:Name="MiniProgressThumb" Width="7" Height="7" Fill="{DynamicResource Accent}" Stroke="{DynamicResource AccentBorder}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-4,0,0,0"/>
                        </Grid>
                        <TextBlock Grid.Column="2" Text="{Binding Text, ElementName=RemainingText}" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="MiniVolumeButton" Content="{Binding Content, ElementName=VolumeButton}" IsEnabled="{Binding IsEnabled, ElementName=VolumeButton}" Style="{StaticResource CompactQuietButton}" Height="34" MinWidth="72" ToolTip="Output volume. Mouse wheel adjusts." AutomationProperties.Name="Mini output volume"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="MiniPreviousButton" IsEnabled="{Binding IsEnabled, ElementName=PreviousButton}" Style="{StaticResource TransportButton}" ToolTip="Previous track" AutomationProperties.Name="Mini previous track">
                                <Grid Width="18" Height="17"><Path Data="M 3,3 L 3,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/><Path Data="M 15,3 L 6,8.5 15,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Grid>
                            </Button>
                            <Button x:Name="MiniPlayPauseButton" IsEnabled="{Binding IsEnabled, ElementName=PlayPauseButton}" Style="{StaticResource PrimaryTransportButton}" ToolTip="{Binding ToolTip, ElementName=PlayPauseButton}" AutomationProperties.Name="Mini play or pause">
                                <Grid Width="19" Height="19">
                                    <Path Data="M 5,2 L 16,9.5 5,17 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Visibility="{Binding Visibility, ElementName=PlayGlyph}"/>
                                    <Grid Visibility="{Binding Visibility, ElementName=PauseGlyph}"><Rectangle Width="4" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Left" Margin="3,3,0,3"/><Rectangle Width="4" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Right" Margin="0,3,3,3"/></Grid>
                                </Grid>
                            </Button>
                            <Button x:Name="MiniNextButton" IsEnabled="{Binding IsEnabled, ElementName=NextButton}" Style="{StaticResource TransportButton}" ToolTip="Next track" AutomationProperties.Name="Mini next track">
                                <Grid Width="18" Height="17"><Path Data="M 3,3 L 12,8.5 3,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Path Data="M 15,3 L 15,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/></Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="MiniRepeatButton2" Content="Repeat All" Style="{StaticResource CompactQuietButton}" Height="34" MinWidth="88" ToolTip="Repeat mode. Click to cycle Off, All, and One."/>
                            <Button x:Name="MiniQueueButton2" Content="Queue" Style="{StaticResource CompactQuietButton}" Height="34" MinWidth="58" Margin="5,0,0,0" ToolTip="Open Queue"/>
                            <Button x:Name="MiniMicroButton2" Content="Micro" Style="{StaticResource CompactQuietButton}" Height="34" MinWidth="54" Margin="5,0,0,0" ToolTip="Collapse into Micro"/>
                            <Button x:Name="MiniExpandButton2" Content="Full" Style="{StaticResource CompactQuietButton}" Height="34" MinWidth="48" Margin="5,0,0,0" ToolTip="Return to full workspace"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Next" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=MiniNextText}" FontSize="13.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- R61.97: Micro is a deliberately composed appliance, not a full player squeezed until it gives up. -->
            <Border Grid.Row="0" Grid.Column="0" x:Name="MicroSurface" Visibility="Collapsed" Background="{DynamicResource PlayerAtmosphere}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0" Padding="5,4,5,5" VerticalAlignment="Stretch">
                <Grid MaxWidth="600" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="MicroTitleRow" Height="Auto"/>
                        <RowDefinition x:Name="MicroTitleGapRow" Height="2"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Text, ElementName=TitleText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <Grid Grid.Row="2" x:Name="MicroSeekSurface" Background="Transparent" Cursor="Hand">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="MicroElapsedText" Text="{Binding Text, ElementName=ElapsedText}" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Cursor="Hand"/>
                        <Grid Grid.Column="1" Height="20" Margin="4,0" VerticalAlignment="Center">
                            <Border x:Name="MicroProgressTrack" Height="3" CornerRadius="0" Background="{DynamicResource ControlTrack}" BorderThickness="0" VerticalAlignment="Center"/>
                            <Border x:Name="MicroProgressFill" Height="3" Width="0" CornerRadius="0" Background="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Ellipse x:Name="MicroProgressThumb" Width="7" Height="7" Fill="{DynamicResource Accent}" Stroke="{DynamicResource AccentBorder}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-4,0,0,0"/>
                        </Grid>
                        <TextBlock Grid.Column="2" x:Name="MicroRemainingText" Text="{Binding Text, ElementName=RemainingText}" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="MicroVolumeButton" Content="Vol" IsEnabled="{Binding IsEnabled, ElementName=VolumeButton}" Style="{StaticResource MicroActionButton}" MinWidth="40" Margin="0,0,5,0" ToolTip="Output volume. Mouse wheel adjusts." AutomationProperties.Name="Micro output volume"/>
                        <Button x:Name="MicroPreviousButton" IsEnabled="False" Style="{StaticResource MicroTransportButton}" ToolTip="Previous track" AutomationProperties.Name="Micro previous track">
                            <Grid Width="17" Height="16"><Path Data="M 3,3 L 3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/><Path Data="M 14,3 L 6,8 14,13 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Grid>
                        </Button>
                        <Button x:Name="MicroPlayPauseButton" Style="{StaticResource MicroPrimaryTransportButton}" ToolTip="Play / Pause" AutomationProperties.Name="Micro play or pause">
                            <Grid Width="18" Height="18">
                                <Path x:Name="MicroPlayGlyph" Data="M 5,2 L 16,9 5,16 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Grid x:Name="MicroPauseGlyph" Visibility="Collapsed"><Rectangle Width="4" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Left" Margin="3,3,0,3"/><Rectangle Width="4" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Right" Margin="0,3,3,3"/></Grid>
                            </Grid>
                        </Button>
                        <Button x:Name="MicroNextButton" IsEnabled="False" Style="{StaticResource MicroTransportButton}" Margin="1,0,5,0" ToolTip="Next track" AutomationProperties.Name="Micro next track">
                            <Grid Width="17" Height="16"><Path Data="M 3,3 L 11,8 3,13 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Path Data="M 14,3 L 14,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/></Grid>
                        </Button>
                        <Button x:Name="MicroRepeatButton" Content="R Off" Style="{StaticResource MicroActionButton}" MinWidth="44" ToolTip="Repeat mode. Click to cycle Off, All, and One."/>
                        <Button x:Name="MicroQueueButton" Content="Queue" Style="{StaticResource MicroActionButton}" MinWidth="44" Margin="4,0,0,0" ToolTip="Open Queue"/>
                        <Button x:Name="MicroMiniButton" Content="Full" Style="{StaticResource MicroActionButton}" MinWidth="36" Margin="4,0,0,0" ToolTip="Return to full workspace"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stable full-width Queue workspace. -->
            <Border Grid.Row="0" Grid.Column="1" x:Name="QueueDrawer" Width="0" Opacity="0" Visibility="Collapsed" Margin="10,0,0,0" Background="{DynamicResource QueueAtmosphere}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1,0,0,0" CornerRadius="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/><RowDefinition Height="0"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions>

                    <!-- R61.97: Queue identity, search and navigation are one command deck. No second header/search band. -->
                    <Grid x:Name="QueueHeaderSurface" Margin="8,5,8,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*" MinWidth="150" MaxWidth="360"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Queue" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="QueueFilterSummaryText" Text="0 / 0" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource TextMuted}" Opacity="0.78" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="QueueSubtitleText" Text="" Visibility="Collapsed"/>
                            <TextBlock x:Name="QueueNowText" Text="" Visibility="Collapsed"/>
                            <TextBlock x:Name="QueueBufferText" Text="" Visibility="Collapsed"/>
                        </StackPanel>
                        <Grid Grid.Column="2" x:Name="QueueSearchSurface" Height="30" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.ColumnSpan="2" x:Name="QueueSearchBox" Style="{StaticResource SearchBox}" Padding="8,1,30,1" VerticalContentAlignment="Center" AutomationProperties.Name="Filter queue"/>
                            <TextBlock Grid.ColumnSpan="2" x:Name="QueueSearchPlaceholder" Text="Search queue" ToolTip="Advanced search: #slot/range, @channel, id:occurrence" Style="{StaticResource Text.Caption}" Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Button Grid.Column="1" x:Name="QueueSearchClearButton" Content="×" Width="28" Height="24" Margin="0,2,2,2" Visibility="Collapsed" Style="{StaticResource ChromeButton}" ToolTip="Clear queue search" AutomationProperties.Name="Clear queue search"/>
                        </Grid>
                        <Button Grid.Column="3" x:Name="QueueSearchPlayButton" Content="Listen" Style="{StaticResource QuietActionButton}" Height="30" MinWidth="52" Padding="7,0" Margin="6,0,0,0" Visibility="Collapsed" IsEnabled="False" ToolTip="Listen only to the matching rows, in table order" AutomationProperties.Name="Listen to queue search results"/>
                        <ToggleButton Grid.Column="4" x:Name="QueueAdvancedFiltersToggle" Content="Filter" Style="{StaticResource SegmentToggle}" Height="30" MinWidth="66" Margin="6,0,0,0" ToolTip="Choose queue filter"/>
                        <Button Grid.Column="5" x:Name="QueueJumpCurrentButton" Content="Current" Style="{StaticResource QuietActionButton}" Height="30" Padding="8,0" Margin="6,0,0,0" ToolTip="Locate the current track while preserving this view when possible"/>
                        <Button Grid.Column="6" x:Name="QueueCollapseButton" Content="Close" Style="{StaticResource ChromeButton}" Width="48" Height="30" Padding="5,0" Margin="6,0,0,0" ToolTip="Hide Queue (Ctrl+Q)" AutomationProperties.Name="Hide queue"/>
                        <Button x:Name="QueueDensityButton" Content="Table" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False"/>
                    </Grid>

                    <!-- Compatibility-owned scope toggles stay nonvisual; Filter opens a menu instead of expanding layout. -->
                    <Grid Grid.Row="2" x:Name="QueueFilterSurface" Height="0" Visibility="Collapsed">
                        <ToggleButton x:Name="QueueFilterAll" Content="All" IsChecked="True"/>
                        <ToggleButton x:Name="QueueFilterUpcoming" Content="Upcoming"/>
                        <ToggleButton x:Name="QueueFilterReady" Content="Ready"/>
                        <ToggleButton x:Name="QueueFilterIssues" Content="Issues"/>
                        <ToggleButton x:Name="QueueFollowToggle" Content="Follow"/>
                        <Border x:Name="QueueAdvancedFilterPanel" Visibility="Collapsed">
                            <StackPanel>
                                <ToggleButton x:Name="QueueFilterHistory" Content="History"/>
                                <ToggleButton x:Name="QueueFilterNextTen" Content="Next 10"/>
                                <ToggleButton x:Name="QueueFilterUnready" Content="Unready"/>
                                <ToggleButton x:Name="QueueFilterFavorites" Content="Favorites"/>
                                <ToggleButton x:Name="QueueFilterUnheard" Content="Unheard"/>
                                <ToggleButton x:Name="QueueFilterFrequent" Content="Frequent"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="QueueHorizonSurface" Visibility="Collapsed"><TextBlock x:Name="QueueHorizonText" Text=""/></Border>
                    </Grid>
                    <Grid Grid.Row="3"><Border Background="{DynamicResource Border}"/></Grid>

                    <Grid Grid.Row="4" x:Name="QueueViewportSurface" ClipToBounds="True" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                    <!-- R61.67: TABLE density is a true desktop work grid: one persistent header, aligned scan columns, and the title lane consumes elastic width. -->
                    <Border Grid.Row="0" Grid.Column="0" x:Name="QueueTableHeader" Height="30" Margin="4,2,2,0" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=QueueList}" Value="Dense"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="QueueTableChannelColumn" Width="240" MinWidth="100" MaxWidth="520" SharedSizeGroup="QueueTableChannel"/>
                                <ColumnDefinition x:Name="QueueTableTimeColumn" Width="72" SharedSizeGroup="QueueTableTime"/>
                                <ColumnDefinition x:Name="QueueTableStateColumn" Width="100" SharedSizeGroup="QueueTableState"/>
                                <ColumnDefinition x:Name="QueueTableMediaColumn" Width="94" SharedSizeGroup="QueueTableMedia"/>
                                <ColumnDefinition x:Name="QueueTablePlaysColumn" Width="58" SharedSizeGroup="QueueTablePlays"/>
                            </Grid.ColumnDefinitions>
                            <GridSplitter x:Name="QueueTableChannelSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                          Background="Transparent" Cursor="SizeWE" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                                          ToolTip="Drag to resize Channel  double-click to reset"/>

                            <TextBlock Text="☆" FontFamily="Segoe UI Symbol, Segoe UI" FontSize="14" Foreground="{DynamicResource TextMuted}" Opacity="0.34" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Favorite"/>
                            <TextBlock Grid.Column="1" Text="#" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" ToolTip="Queue position. Row order is playback order."/>
                            <TextBlock Grid.Column="2" Text="Title" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="Channel" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="Time" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,7,0"/>
                            <TextBlock Grid.Column="5" Text="State" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            <TextBlock Grid.Column="6" Text="Media" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="7,0,0,0" ToolTip="Audio / artwork / video / visualizer readiness"/>
                            <TextBlock Grid.Column="7" Text="Plays" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,7,0"/>
                            
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="QueueList" Tag="Dense" Margin="4,0,2,2" Background="Transparent" BorderThickness="0" SelectionMode="Extended" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemContainerStyle="{StaticResource QueueItemStyle}" AutomationProperties.Name="Session queue" ItemTemplate="{StaticResource QueueTableRowTemplate}">
                    </ListBox>
                    <Border Grid.Row="1" Grid.Column="0" x:Name="QueueEmptyState" Visibility="Collapsed" Margin="18,20" Background="Transparent" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                            <TextBlock x:Name="QueueEmptyTitleText" Text="Nothing matches" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="QueueEmptyBodyText" Text="Clear the search or choose a broader queue view." Style="{StaticResource Text.Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" x:Name="QueueDropEndIndicator" Visibility="Collapsed" Panel.ZIndex="20" Height="2" Margin="18,0,18,10" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" IsHitTestVisible="False"/>
                    <Grid Grid.Row="1" Grid.Column="1" x:Name="QueueOverviewSurface" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="24" Margin="0" Background="Transparent" ToolTip="Queue overview. Click or drag to navigate." AutomationProperties.Name="Queue overview navigation">
                        <Border x:Name="QueueOverviewRail" Width="1" HorizontalAlignment="Center" Background="{DynamicResource QueueHorizonRailBrush}" Opacity="0.38" IsHitTestVisible="False"/>
                        <Canvas x:Name="QueueOverviewTopologyCanvas" Width="18" Background="Transparent" IsHitTestVisible="False" Visibility="Collapsed"/>
                        <Canvas x:Name="QueueOverviewCanvas" Width="18" Background="Transparent">
                            <Border x:Name="QueueOverviewViewport" Width="8" Height="18" Canvas.Left="5" BorderBrush="{DynamicResource TextMuted}" BorderThickness="1" Background="{DynamicResource SurfacePressed}" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="QueueOverviewSelectionMarker" Width="8" Height="3" Canvas.Left="5" Background="{DynamicResource Info}" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="QueueOverviewCurrentNode" Width="8" Height="5" Canvas.Left="5" Background="{DynamicResource Accent}" Opacity="0" IsHitTestVisible="False"/>
                        </Canvas>
                    </Grid>
                    <Canvas Grid.Row="1" Grid.Column="0" Panel.ZIndex="22" IsHitTestVisible="False">
                        <Border x:Name="QueueCurrentMarker" Width="2" Height="18" Background="{DynamicResource Accent}" Opacity="0" Visibility="Collapsed" Canvas.Left="4"/>
                    </Canvas>
                    </Grid>

                    <Border Grid.Row="5" x:Name="QueueSelectionBar" Visibility="Collapsed" Margin="8,0,8,6" Padding="8,6" CornerRadius="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="QueueSelectionCountText" Text="" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="QueueSelectionPlayNextButton" Content="Play next" Style="{StaticResource OverlayActionButton}"  Margin="6,0,0,0"/>
                            <Button Grid.Column="2" x:Name="QueueSelectionPrepareButton" Content="Prepare" Style="{StaticResource OverlayActionButton}"  Margin="6,0,0,0"/>
                            <Button Grid.Column="3" x:Name="QueueSelectionLaterButton" Content="Later +5" Style="{StaticResource OverlayActionButton}"  Margin="6,0,0,0" ToolTip="Move selected occurrences five slots later"/>
                            <Button Grid.Column="4" x:Name="QueueSelectionFavoriteButton" Content="★" Style="{StaticResource OverlayActionButton}" Width="36" Padding="0" Margin="6,0,0,0" ToolTip="Toggle favorite for selected tracks"/>
                            <Button Grid.Column="5" x:Name="QueueSelectionRemoveButton" Content="Remove" Style="{StaticResource OverlayActionButton}"  Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- R61.96: Queue summary lives beside the Queue title; no second footer strip. -->
                    <Grid Grid.Row="6" Height="0" Visibility="Collapsed">
                        <TextBlock x:Name="QueueRevisionText" Text="" Visibility="Collapsed" Style="{StaticResource Text.Mono}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
            <Border Width="270" Margin="0,0,0,10" Padding="12,10" CornerRadius="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Output volume" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="VolumeValueText" Text="" FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>
