                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Padding="7,3" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False">
                                <TextBlock Text="ESC" Style="{StaticResource Text.Mono}"/>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource Border}"/>
                        <Border Grid.Row="2" x:Name="CommandPaletteContextBand" Margin="8,7,8,0" Padding="0,0,0,7" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock x:Name="CommandPaletteContextText" Text="Context: Player" Style="{StaticResource Text.ContextLens}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="3" x:Name="CommandPaletteList" Margin="0,8,0,6" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CommandPaletteItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="4" Margin="8,4,8,2">
                            <TextBlock Text="Enter: run    Up/Down: navigate    Ctrl+K: actions    F1: shortcuts" Style="{StaticResource Text.Caption}"/>
                            <TextBlock x:Name="CommandPaletteSummary" Text="0 commands" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>