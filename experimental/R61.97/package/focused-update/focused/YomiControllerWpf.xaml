                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="HeaderStateDot" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="HeaderStateText" Text="Ready" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
