    <!-- R42 Follow Fidelity: clearing search resumes the existing Follow-current behavior immediately when Follow is enabled; no new chrome or state. -->
    <!-- R41 Queue Navigation: current-jump recovery quietly normalizes the existing queue view, and already-active scope clicks no longer create redundant notifications. No new chrome. -->
    <!-- R40 Queue Fidelity: existing Follow preference now governs reopen scrolling; queue filters/search cannot leave invisible bulk selections armed. No new chrome. -->
    <!-- R39 Hierarchy Restraint: current queue identity remains explicit through NOW/status while the redundant full-row accent wash is removed; no added chrome. -->
    <!-- R38 Priority Fidelity: timing never masks policy-deferred, fault-isolated, SLA-yielded, preparing or failure state; current-row fill reuses the restrained existing accent-soft palette. -->
    <!-- R37 Horizon Legibility: settled current/upcoming queue rows reuse the existing safety line for ENDS / STARTS timing; readiness and risk remain higher priority. -->
    <!-- R36 Reprise Surface: past queue occurrences label the existing play-next action AGAIN, making positional intent explicit without another control. -->
    <!-- R35 Intent Surface: existing queue hover buttons adapt to current positional meaning; immediate-next uses LATER instead of a no-op NEXT. -->
    <!-- R34 Horizon Surface: live current-occurrence time context layered onto the existing readiness surface; retained R32 adaptive controls.  hover-only queue intent, explicit mini/full transitions, and direct surrounding-track manipulation without touching playback authority. -->
    <Grid Background="{DynamicResource WorkbenchAtmosphere}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition x:Name="ClassicMenuRow" Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="StatusBarRow" Height="23"/>
        </Grid.RowDefinitions>

        <!-- R61.76: stronger but quiet application frame. The visual edge is distinct from the resize hit target. -->
        <Border Grid.RowSpan="4" Panel.ZIndex="1999" IsHitTestVisible="False" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="2" Background="Transparent"/>
        <Grid Grid.RowSpan="4" Panel.ZIndex="2000" IsHitTestVisible="False" Opacity="0.58">
            <Path Data="M 2,12 L 2,2 12,2" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.4" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Path Data="M 0,2 L 10,2 10,12" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            <Path Data="M 2,0 L 2,10 12,10" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.4" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
            <Path Data="M 0,10 L 10,10 10,0" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- R61.52 two-scale registration field: micro coordinates plus sparse macro landmarks. Both are static and noninteractive. -->

        <!-- Product chrome: identity, state, then standard window actions. -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource ChromeAtmosphere}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="9,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="18" Height="18" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="0">
                    <Image x:Name="TitleBarIcon" Stretch="Uniform" SnapsToDevicePixels="True"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
                    <TextBlock Text="YOMI 4.2.0.8" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TitleTaglineText" Text="  YouTube OBS Music Interface" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="AppearanceBadge" Text="" Visibility="Collapsed" Style="{StaticResource Text.Mono}" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>

