<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration" x:Name="RootWindow" Title="YOMI 4.2.0.8" Width="1180" Height="740" MinWidth="430" MinHeight="126" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14.5" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <!-- R61.97 COMPACT CONTROLLER CALIBRATION: intentional micro appliance geometry, drag-stable scale transitions, one-row Queue command deck, scalable pixel visualizer, and color-agnostic sidebar trim. -->
