                    <Grid Width="16" Height="16">
                        <Path Data="M 3,3 L 13,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                        <Path Data="M 13,3 L 3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
